-- Kịch bản này điều chỉnh các thuộc tính của dịch vụ Lighting để đạt độ sáng tối đa
local Lighting = game:GetService("Lighting")

-- 1. Thiết lập các thông số cơ bản về độ sáng
Lighting.Brightness = 2            -- Tăng độ sáng tổng thể (mặc định thường là 1)
Lighting.GlobalShadows = false     -- Tắt hoàn toàn bóng đổ của các vật thể
Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255) -- Làm sáng các vùng ngoài trời
Lighting.Ambient = Color3.fromRGB(255, 255, 255)        -- Làm sáng các vùng tối/trong nhà

-- 2. Tùy chỉnh đồng hồ thời gian (tùy chọn)
Lighting.ClockTime = 14            -- Đặt thời gian vào buổi chiều (khoảng 2 giờ chiều) để có ánh sáng tự nhiên tốt nhất
